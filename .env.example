# ============================================
# TELECOM AI ASSISTANT - CONFIGURATION
# ============================================
# Copy this file to .env and customize settings

# ============================================
# APPLICATION
# ============================================
APP_NAME=Telecom AI Assistant
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production
API_VERSION=v1
HOST=0.0.0.0
PORT=8080

# ============================================
# DATABASE (Optional - PostgreSQL)
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telecom_ai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============================================
# REDIS (Optional - Caching)
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ============================================
# LLM - OLLAMA
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
# Recommended models (in order of preference):
#   - qwen2.5:7b      (Best accuracy, recommended)
#   - llama3.1:8b     (Good balance)
#   - mistral:7b      (Fast, good quality)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120
OLLAMA_NUM_PREDICT=150

# ============================================
# RAG - CHROMADB & EMBEDDINGS
# ============================================
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=telecom_knowledge
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# CRAG Settings
CRAG_RELEVANCE_THRESHOLD=0.6
CRAG_AMBIGUOUS_THRESHOLD=0.3
CRAG_TOP_K=10

# ============================================
# VOICE - SPEECH-TO-TEXT (Faster-Whisper)
# ============================================
# Model options: tiny.en, base.en, small.en, medium.en, large-v3
# - tiny.en:   Fastest, may hallucinate
# - base.en:   Recommended balance (used by default)
# - small.en:  Better accuracy, slower
# - large-v3:  Best accuracy, requires more RAM
STT_MODEL=base.en

# Device: cpu or cuda
# Note: CUDA requires cublas64_12.dll (CUDA Toolkit 12.x)
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# ============================================
# VOICE - TEXT-TO-SPEECH (Kokoro-82M)
# ============================================
# Kokoro is a lightweight 82M parameter TTS model
# Runs locally, Apache licensed, high quality output

# Voice options:
#   - af_heart  (American Female - warm)
#   - af_bella  (American Female - professional)
#   - am_adam   (American Male)
#   - bf_emma   (British Female)
#   - bm_george (British Male)
KOKORO_VOICE=af_heart

# Language codes:
#   - a = American English
#   - b = British English
KOKORO_LANG_CODE=a

# ⚡ PERFORMANCE TIP:
# Kokoro runs 5-10x faster on GPU (CUDA)
# To enable CUDA for Kokoro:
#   pip uninstall torch torchaudio -y
#   pip install torch torchaudio --index-url https://download.pytorch.org/whl/cu121

# ============================================
# VOICE - VAD (Voice Activity Detection)
# ============================================
# Silero-VAD neural network model
# Threshold: 0.0 (very sensitive) to 1.0 (only loud speech)
VAD_THRESHOLD=0.85
VAD_MIN_SPEECH_DURATION=0.25

# ============================================
# FRONTEND
# ============================================
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080

# ============================================
# SECURITY
# ============================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
