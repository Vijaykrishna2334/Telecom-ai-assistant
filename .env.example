# Application
APP_NAME=Telecom AI Assistant
DEBUG=false
SECRET_KEY=your-secret-key-here
API_VERSION=v1
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/telecom_ai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
# Options: llama3.2:3b (generic) or tele-llm (telecom-specialized, run setup_tele_llm.bat first)
OLLAMA_MODEL=tele-llm
OLLAMA_TIMEOUT=120
OLLAMA_NUM_PREDICT=256

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=telecom_knowledge

# Voice Processing - STT (Speech-to-Text)
# Model options: tiny.en, base.en, small.en (recommended), medium.en, large-v3
# Larger models = better accuracy but slower. small.en is best for Indian English.
STT_MODEL=small.en
STT_DEVICE=cuda

# TTS Provider: piper, kokoro, or cosyvoice
TTS_PROVIDER=kokoro
TTS_VOICE=en_US-ljspeech-high
TTS_SAMPLE_RATE=22050

# Kokoro TTS (82M lightweight)
KOKORO_VOICE=af_heart
KOKORO_LANG_CODE=a

# CosyVoice TTS (150ms streaming, voice cloning)
COSYVOICE_MODEL=CosyVoice2-0.5B
COSYVOICE_VOICE=default

# VAD
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION=0.25

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Security
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
